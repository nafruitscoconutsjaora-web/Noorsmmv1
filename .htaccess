# Apache Configuration for SMM Panel (Root DocumentRoot: public_html)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory listing
    Options -Indexes

    # Block access to hidden files and directories (except .well-known for SSL)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Block access to sensitive application directories
    RewriteRule ^(app|config|database|storage|vendor|bootstrap|bin|tests|docs)/ - [F,L]

    # Block access to sensitive files
    <FilesMatch "(^\.env|composer\.(json|lock)|package(-lock)?\.json|metadata\.json|\.(sql|log|md|sh))$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order deny,allow
            Deny from all
        </IfModule>
    </FilesMatch>

    # Allow direct access to the installer if required
    RewriteCond %{REQUEST_URI} ^/install(/.*)?$ [NC]
    RewriteRule ^ - [L]

    # If the requested static asset exists in public/, rewrite internally to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d [OR]
    RewriteCond public/$1 -f [OR]
    RewriteCond public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Route all application routes internally to public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 500 "Apache mod_rewrite is required to run this application."
</IfModule>
